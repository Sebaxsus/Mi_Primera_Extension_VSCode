{
  "name": "productivity-timer",
  "displayName": "Productivity Timer - Pomodoro & Motivación",
  "description": "Temporizador Pomodoro con sistema de rachas, puntos y frases motivacionales",
  "version": "1.0.0",
  "publisher": "sebaxsus",
  "repository": "https://github.com/Sebaxsus/Mi_Primera_Extension_VSCode",
  "icon": "media/extension_icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "productivityTimer.startWorkSession",
        "title": "🍅 Iniciar Sesión de Trabajo",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.startBreak",
        "title": "☕ Iniciar Descanso",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.stopTimer",
        "title": "⏹️ Detener Temporizador",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.setDailyLimit",
        "title": "⏰ Establecer Límite Diario",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.showStats",
        "title": "📊 Ver Estadísticas y Rachas",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.configure",
        "title": "⚙️ Configurar Temporizador",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.configureSound",
        "title": "🔊 Configurar Sonido de Alarma",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.testAlarm",
        "title": "🔊 Probar el Sonido de Alarma",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.enableDailyReminder",
        "title": "⏰ Activar Recordatorio Diario",
        "category": "Productivity Timer"
      },
      {
        "command": "productivityTimer.disableDailyReminder",
        "title": "⏰ Desactivar Recordatorio Diario",
        "category": "Productivity Timer"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "productivityTimerContainer",
          "title": "Productivity Timer",
          "icon": "media/player-icon.svg"
        }
      ]
    },
    "views": {
      "productivityTimerContainer": [
        {
          "id": "productivityTimer.playerView",
          "name": "Reproductor",
          "type": "webview",
          "icon": "media/player-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Productivity Timer",
      "properties": {
        "productivityTimer.workDuration": {
          "type": "number",
          "default": 30,
          "description": "Duración de la sesión de trabajo en minutos"
        },
        "productivityTimer.breakDuration": {
          "type": "number",
          "default": 10,
          "description": "Duración del descanso en minutos"
        },
        "productivityTimer.minimumDailyMinutes": {
          "type": "number",
          "default": 30,
          "description": "Minutos mínimos diarios para mantener racha"
        },
        "productivityTimer.stretchDuration": {
          "type": "number",
          "default": 5,
          "description": "Duración de la etapa de estiramiento en minutos"
        },
        "productivityTimer.dailyReminderTime": {
          "type": "string",
          "default": "20:00",
          "description": "Hora (formato 24h HH:mm) del recordatorio diario de Task Scheduler, si está activado"
        },
        "productivityTimer.stretchVideos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "URLs de YouTube con rutinas de estiramiento. Si está vacía, se usa la lista curada por defecto de la extensión."
        },
        "productivityTimer.alarmType": {
          "type": "string",
          "enum": [
            "local",
            "youtube",
            "spotify"
          ],
          "default": "local",
          "description": "Tipo de alarma a usar"
        },
        "productivityTimer.alarmPath": {
          "type": "string",
          "default": "",
          "description": "Ruta del archivo de sonido local o URL de YouTube"
        },
        "productivityTimer.volume": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "Volumen de la alarma (0-100)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js && npm run postcompile",
    "package": "node esbuild.js --production && npm run postcompile",
    "postcompile": "node -e \"require('fs').mkdirSync('out', { recursive: true }); require('fs').copyFileSync('src/player_bridge.ps1', 'out/player_bridge.ps1')\"",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.x",
    "@typescript-eslint/parser": "^5.x",
    "esbuild": "^0.28.2",
    "eslint": "^8.x",
    "typescript": "^5.0.0",
    "node-fetch": "^2.6.7"
  }
}
